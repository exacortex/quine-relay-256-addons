ARG BASE_IMAGE=quine-relay-256
FROM ${BASE_IMAGE}

USER root
RUN command -v strace > /dev/null || (apt-get update -qq && apt-get install -y -qq strace > /dev/null && apt-get clean)
COPY run-lap-c-trace.sh /usr/local/bin/run-lap-c-trace.sh
COPY trace-audit.py /usr/local/bin/trace-audit.py
RUN chmod +x /usr/local/bin/run-lap-c-trace.sh /usr/local/bin/trace-audit.py

USER qr
ENTRYPOINT ["bash", "/usr/local/bin/run-lap-c-trace.sh"]
